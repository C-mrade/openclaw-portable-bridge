# Generate with: openssl rand -hex 32
BRIDGE_ADMIN_TOKEN=

# Local operator endpoint used by bridge-operator.
BRIDGE_BROKER_URL=http://127.0.0.1:17443

# Optional OpenClaw-native approval delivery. Numeric private Telegram IDs only.
BRIDGE_APPROVAL_TARGET=
BRIDGE_APPROVER_IDS=

# Optional environment file containing the OpenClaw Gateway token SecretRef
# source. Needed only by the proactive notifier CLI.
BRIDGE_GATEWAY_ENV_FILE=

# Optional build inputs for creating signed guest packages.
BRIDGE_RELEASE_KEY_FILE=
BRIDGE_RELEASE_PUBLIC_KEY=
