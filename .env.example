# Generate with: openssl rand -hex 32
BRIDGE_ADMIN_TOKEN=

# Local operator endpoint used by bridge-operator.
BRIDGE_BROKER_URL=http://127.0.0.1:17443

# Use a dedicated Telegram bot. Do not reuse a bot already polled by OpenClaw.
BRIDGE_TELEGRAM_BOT_TOKEN=
BRIDGE_TELEGRAM_APPROVER_ID=

# Optional build inputs for creating signed guest packages.
BRIDGE_RELEASE_KEY_FILE=
BRIDGE_RELEASE_PUBLIC_KEY=
